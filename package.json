{
  "name": "herizon-cars-theme",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/button-assets.mjs && vite build --watch",
    "build": "node scripts/button-assets.mjs && vite build",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
